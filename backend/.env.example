NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skylink_clone
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
ADMIN_SETUP_KEY=replace_with_a_different_long_secret
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
CONTACT_TO_EMAIL=
PUBLIC_SITE_URL=http://localhost:5173

# Firebase Google Login (optional, requires Firebase Console setup)
# Keep the downloaded JSON OUTSIDE the frontend and OUT of git.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
